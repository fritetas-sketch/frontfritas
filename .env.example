# Copy to .env and fill in as needed. All values are optional.

# ---- Discord login (optional) ----
# Client id of your Discord application. Add https://front.fritas.fr as an
# OAuth2 redirect in the Discord developer portal. Leave empty to hide the
# Discord button (the game stays fully playable with a manual pseudo).
VITE_DISCORD_CLIENT_ID=

# ---- Multiplayer WebSocket URL (optional) ----
# By default the client connects to the same origin it was served from
# (wss://front.fritas.fr in production), which is what you want when the Node
# server serves the built client. Only set this to override, e.g. if the
# socket lives on a different host.
# VITE_WS_URL=wss://front.fritas.fr

# ---- Server port (optional) ----
# Port the Node game server listens on. The reverse proxy forwards to it.
PORT=8787
