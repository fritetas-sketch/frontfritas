{
  "name": "frontfritas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Real-time territorial conquest game (an OpenFront.io-style browser game)",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc --noEmit -p tsconfig.server.json && vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/server.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "server": "node --experimental-strip-types server/index.ts",
    "serve:prod": "node dist-server/server.mjs",
    "start": "npm run build && npm run serve:prod"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
